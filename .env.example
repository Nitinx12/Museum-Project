# Museum ETL Environment Configuration
# Copy this file to .env and fill in the required values.

# --- PostgreSQL Warehouse ---
# The database where bronze, silver, and gold layers reside.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=museum
POSTGRES_USERNAME=museum
POSTGRES_PASSWORD=museum_password

# --- MongoDB Source ---
# The production database containing the museum collections.
MONGO_URI=mongodb://user:password@localhost:27017
MONGO_DB=museum_db

# --- Airflow Configuration ---
# Used for local deployment via Docker Compose.
AIRFLOW_UID=50000
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
